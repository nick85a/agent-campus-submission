# mock 模式无需配置。live 必须配置以下三个变量，服务须支持流式 tool calling。
MODEL_BASE_URL=https://your-provider.example/v1
MODEL_ID=your-tool-calling-model
MODEL_API_KEY=
# 可选生成参数；仅 live 模式读取。
MODEL_MAX_TOKENS=2048
MODEL_CONTEXT_WINDOW=32000
# 仅在服务支持 thinking 参数时开启；Kimi K2.6 可设 true 关闭思考以节省 Token。
MODEL_DISABLE_THINKING=false
# 本机 CLI 身份标识，不是生产身份认证。
SCHEDULER_ACTOR=local-user
